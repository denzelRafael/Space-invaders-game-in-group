import pygame

pygame.init()
clock = pygame.time.Clock() 

screen = pygame.display.set_mode((800, 600))
pygame.display.set_caption("my Game")

# Create player
player = pygame.Rect(375, 530, 50, 30)
player_speed = 8
player_image = pygame.image.load("Space_invaders.character.png")
player_image = pygame.transform.scale(player_image, (50, 30)) # Scale the image to match the player rectangle size
player_x = 375

#Bullet settings
bullets = []
bullet_speed = 8
shoot_delay = 700
last_shot = pygame.time.get_ticks() 



running = True


while running:

    screen.fill((0, 0, 0,))

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
            
    keys = pygame.key.get_pressed()

 #Shooting bullets (player and enemies)
    current_time = pygame.time.get_ticks()
    if keys[pygame.K_SPACE] and current_time - last_shot > shoot_delay:
         bullet = pygame.Rect(player.centerx - 2, player.top, 5, 10)
         bullets.append(bullet)
         last_shot = current_time


    # Move bullets and draw them
    for bullet in bullets[:]:

        bullet.move()
        bullet.draw(screen)
    
        if bullet.speed < 0 and bullet.rect.bottom < 0:
            bullets.remove(bullet)

        elif bullet.speed > 0 and bullet.rect.top > 600:
            bullets.remove(bullet)
            
    
    # Player movement
    if keys[pygame.K_LEFT]:
        player.x -= player_speed
        player.x = max(player.x, 0)  # Prevent player from going off the left edge

    if keys[pygame.K_RIGHT]:
        player.x += player_speed
        player.x = min(player.x, 750)  # Prevent player from going off the right edge

   # Draw player
    pygame.draw.rect(screen, (0, 255, 0), player)
    screen.blit(player_image, player)
    



    pygame.display.flip()
    pygame.display.update()
    clock.tick(60)

pygame.quit() 